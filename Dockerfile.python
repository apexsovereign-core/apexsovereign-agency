# syntax=docker/dockerfile:1.4
# ==============================================================================
# APEXSOVEREIGN.AI — PYTHON 3.11 WORKER RUNTIME DOCKERFILE
# Multi-Stage Build for AuraPharm Basal Sweeper & Governance Sentinels
# Isolated Virtualenv Context & Hardened Non-Root Security (appuser:10001)
# ==============================================================================

# Stage 1: Build virtualenv & pre-compile wheels
FROM python:3.11-slim-bookworm AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libffi-dev \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY services/aurapharm/requirements.txt ./
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt

# Stage 2: Hardened Minimal Production Runtime
FROM python:3.11-slim-bookworm AS runtime

LABEL maintainer="ApexSovereign Holdings DevOps <infra@apexsovereign.ai>"
LABEL service="apexsovereign-python-workers"

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    tzdata \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 10001 appgroup \
    && useradd -u 10001 -g appgroup -s /sbin/nologin -M appuser

# Extract isolated virtualenv from builder
COPY --from=builder /opt/venv /opt/venv

# Copy services tree
COPY --chown=appuser:appgroup services/ /app/services/

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

USER 10001:10001

EXPOSE 8000 8001

HEALTHCHECK --interval=15s --timeout=4s --start-period=5s --retries=3 \
    CMD curl -f http://127.0.0.1:${PORT:-8001}/health || exit 1

CMD ["uvicorn", "services.aurapharm.basal_load_sweeper:app", "--host", "0.0.0.0", "--port", "8001"]
