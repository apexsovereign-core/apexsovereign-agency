# ==============================================================================
# ApexSovereign.ai - Backend Environment Configuration
# ==============================================================================

# PostgreSQL Connection String (Supabase, Neon, or Render PostgreSQL)
# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://postgres:your_password@db.your_supabase_ref.supabase.co:5432/postgres

# Application Security Secret (Used for timing-safe HMAC lease signatures)
APP_SECRET_API_KEY=your_64_character_hex_or_alphanumeric_secret_key

# PayPal REST API v2 Credentials (from developer.paypal.com)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# CORS Allowed Origins (Comma-separated list of frontends, e.g. Vercel URLs)
ALLOWED_ORIGINS=https://apexsovereignai.vercel.app,http://localhost:3000

# Port (Automatically injected by Render in production)
PORT=10000
