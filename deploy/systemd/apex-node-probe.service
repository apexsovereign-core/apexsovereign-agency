[Unit]
Description=ApexSovereign.ai AethelMesh High-Concurrency Node Probe & Geothermal Failover
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/apexsovereign
EnvironmentFile=/opt/apexsovereign/.env.production
ExecStart=/usr/bin/python3 /opt/apexsovereign/services/aethelmesh/probe.py
Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
