# ============================================================================
# ApexSovereign.ai - FOUR-TIER FLEET COMMAND OPERATOR SYSTEMD SERVICE
# File: deploy/systemd/apexsovereign-operator.service
# Target: Sovereign Production Bare-Metal & NVLink Compute Nodes
# ============================================================================

[Unit]
Description=ApexSovereign.ai Master Four-Tier Fleet Command & Telemetry Operator
Documentation=https://apexsovereign.ai/docs/architecture/fleet-operator
After=network.target network-online.target sys-fs-cgroup.mount time-sync.target
Wants=network-online.target
Conflicts=shutdown.target

[Service]
Type=simple
User=apex
Group=apex
WorkingDirectory=/etc/apexsovereign

# Binary Executable
ExecStart=/usr/local/bin/sovereign-operator
ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30s

# Environment Configurations
EnvironmentFile=-/etc/apexsovereign/operator.env
Environment=RUST_LOG=info,sovereign_operator=debug
Environment=OPERATOR_PORT=9100
Environment=RUST_BACKTRACE=1
Environment=APEX_ENVIRONMENT=production

# Resource Ceilings & Descriptors
LimitNOFILE=1048576
LimitNPROC=524288
LimitMEMLOCK=infinity
LimitCORE=infinity
TasksMax=1048576

# Hardened Linux Sandboxing & System Protection
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=false
DevicePolicy=closed
DeviceAllow=/dev/null rw
DeviceAllow=/dev/urandom r
DeviceAllow=/dev/nvidia* rw
DeviceAllow=/dev/nvidiactl rw
DeviceAllow=/dev/nvidia-uvm rw
DeviceAllow=/dev/nvidia-uvm-tools rw

# Kernel & System Access Restrictions
ProtectKernelTunables=true
ProtectKernelModules=false
ProtectControlGroups=false
MemoryDenyWriteExecute=false
RestrictRealtime=false
RestrictSUIDSGID=true
NoNewPrivileges=true

# Linux Capabilities for eBPF and Hardware Isolation
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN CAP_BPF CAP_SYS_ADMIN CAP_SYS_PTRACE
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_ADMIN CAP_BPF CAP_SYS_ADMIN

# Filesystem Access
ReadWritePaths=/var/log/apexsovereign /sys/fs/cgroup /sys/fs/bpf
ReadOnlyPaths=/etc/apexsovereign

# Restart Policies
Restart=always
RestartSec=5s
RestartPreventExitStatus=137

# Watchdog Integration
WatchdogSec=30s

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=apexsovereign-operator

[Install]
WantedBy=multi-user.target
