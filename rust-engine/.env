#[tokio::main]
async fn main() {
    // Load environment variables (like OPENAI_API_KEY from a .env file)
    dotenvy::dotenv().ok();

    // Set up shared app state if you have one
    let state = AppState { /* ... */ };

    // Build your Axum router and add the route
    let app = Router::new()
        .route("/api/llm-stream", axum::routing::post(stream_llm_task_handler))
        .with_state(state);

    // Run the server
    let listener = tokio::net::TcpListener::bind("127.0.0.1:8080").await.unwrap();
    println!("Engine running on http://127.0.0.1:8080");
    axum::serve(listener, app).await.unwrap();
}